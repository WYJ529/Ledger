# Path to your Android SDK. Android Studio usually writes this for you.
sdk.dir=/path/to/Android/sdk

# Backend base URL baked into the APK at build time.
API_BASE_URL=http://10.0.2.2:3000

# Optional verified HTTPS invitation domain, matching backend PUBLIC_APP_URL (host only).
APP_LINK_HOST=ledger.invalid

# Google OAuth WEB client ID (same value as backend GOOGLE_CLIENT_ID).
# Optional: the build falls back to this team value when the entry is missing or blank.
GOOGLE_CLIENT_ID=543187156899-8i4lr8gsegf849ckevgjt1v3osipnei9.apps.googleusercontent.com

# Other API keys, secrets, and configurations

# Contact Us opens this project support page; no message is sent automatically.
LEDGER_SUPPORT_URL=https://github.com/WYJ529/Ledger/issues/new
# Set the real HTTPS store listing after publication; blank shows an explanatory dialog.
LEDGER_STORE_URL=
