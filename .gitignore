# Node / TypeScript
# These are repeated in backend/.gitignore, but are needed here too: the moment
# anyone adds a second Node project (an e2e/ suite, a scripts/ folder), its
# node_modules would otherwise be committed.
node_modules/
.npm-cache/
.tools/
dist/
coverage/
*.tsbuildinfo

# Secrets. Real environment files must never be committed; commit an .env.example
# with placeholder values instead so the required variables are still documented.
.env
.env.*
!.env.example

# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# macOS files
.DS_Store

# Verity — snapshots of analyzed files (machine state, never commit)
.verity/.snapshot/

Project_Description.pdf
Submission_Guidelines.pdf
requirement_and_design/
output/
# Keep generated evidence ignored; allow the reviewed test-run summary.
/documentation/res/*
!/documentation/res/testing/
/documentation/res/testing/*
!/documentation/res/testing/backend-interface-summary.txt
!/documentation/res/testing/backend-ci-2026-11-20.txt
!/documentation/res/testing/android-historical-summary.txt
!/documentation/res/testing/android-e2e-2026-11-19.txt
!/documentation/res/testing/backend-nfr-2026-11-27.txt
!/documentation/res/testing/android-e2e-2026-11-20.txt
!/documentation/res/testing/android-e2e-diagnostics-2026-11-20.txt
!/documentation/res/testing/coverage-43b5d0a/
/documentation/res/testing/coverage-43b5d0a/*
!/documentation/res/testing/coverage-43b5d0a/*.png
!/documentation/res/testing/coverage-43b5d0a/provenance.txt
!/documentation/res/testing/coverage-2026-11-20/
