# Node / TypeScript
# These are repeated in backend/.gitignore, but are needed here too: the moment
# anyone adds a second Node project (an e2e/ suite, a scripts/ folder), its
# node_modules would otherwise be committed.
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets. Real environment files must never be committed; commit an .env.example
# with placeholder values instead so the required variables are still documented.
.env
.env.*
!.env.example

# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# macOS files
.DS_Store

# Verity — snapshots of analyzed files (machine state, never commit)
.verity/.snapshot/
