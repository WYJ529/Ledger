# Server configuration
PORT=3000
# Loopback is sufficient for the Android emulator. Docker Compose overrides this to 0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development

# Database for user accounts and sessions (required).
MONGODB_URI=mongodb://localhost:27017/ledger

# Optional shareable web origin; blank uses ledger:// invitation links.
# Use a backend address reachable by recipients, e.g. https://your-ledger.example.com
PUBLIC_APP_URL=
# Optional SHA-256 signing-certificate fingerprints for verified HTTPS App Links (comma separated).
# Configure the same domain as APP_LINK_HOST in frontend/local.properties.
ANDROID_SHA256_FINGERPRINTS=

# Google Auth: use the WEB OAuth client ID, not the Android client ID.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Other API keys, secrets, and configurations
# M1 owner identity (fill in your actual name).
OWNER_FIRST_NAME=
OWNER_LAST_NAME=
# Leave empty locally. Set the server public IP when deploying to the cloud.
SERVER_PUBLIC_IP=

# Course upstream (standard WebSocket, not Socket.IO)
COURSE_WS_URL=wss://8.229.22.124

# Feature1: optional image/PDF recognition. Keep this key on the backend only.
# Manual entries and CSV imports work on the device without this service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
